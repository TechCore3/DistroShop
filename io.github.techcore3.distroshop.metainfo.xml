<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.techcore3.distroshop</id>
  <name>DistroShop</name>
  <summary>Browse, test, and flash Linux distribution images</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.techcore3">
    <name>TechCore3</name>
  </developer>
  <description>
    <p>Browse Linux distributions, try their installation images in a virtual machine, and write images to removable USB drives.</p>
    <ul>
      <li>Browse and refresh a catalog of Linux distributions.</li>
      <li>Download distribution images and test them in a virtual machine.</li>
      <li>Write images to a removable device using safe or fast mode.</li>
    </ul>
    <p>Flashing overwrites the selected device. Double-check the target device before writing an image.</p>
  </description>
  <categories>
    <category>System</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">io.github.techcore3.distroshop.desktop</launchable>
  <releases>
  <release version="1.0.3" date="2026-10-23">
    <description>
      <p>Fixed bug that made VMs not download their respective isos if missing</p>
    </description>
  </release>
</releases>
